# ------------------------------------------------------------------
# CivicEye environment template
# Copy to `.env.local` and fill in real values.
# ------------------------------------------------------------------

# --- Supabase (PostgreSQL + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase (Google Sign-In + FCM push notifications) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-side only - NEVER expose to the browser)
# Get this from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# IMPORTANT: Replace all actual line breaks with the literal characters \n (backslash + n)
# Example: "private_key": "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT=

# --- Maps (Google Maps API or Mapbox) ---
NEXT_PUBLIC_MAPS_PROVIDER=google # "google" | "mapbox"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Cloudinary (Image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public cloud name + unsigned upload preset for client-side uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
